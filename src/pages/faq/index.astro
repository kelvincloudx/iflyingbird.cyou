---
// src/pages/faq/index.astro
import Layout from '../../layouts/Layout.astro';
import { FAQS } from '../../data/faq';
import { COMMERCIAL_AFF_URL } from '../../data/plans';

const title = "FlyingBird常见问题解答 FAQ｜套餐流量、客户端与连接排查";
const description = "收录 10 条 FlyingBird 最常见的服务问答，包含月付套餐流量、一次性流量包对比、网络超时排查与订阅安全信息。";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout title={title} description={description} canonicalPath="/faq/" structuredData={structuredData}>
  <section class="faq-page">
    <div class="container">
      <div class="section-header text-center">
        <span class="tag-badge">答疑中心</span>
        <h1 class="section-title">FlyingBird 常见问题 FAQ</h1>
        <p class="section-desc">
          我们为您整理了 10 条最核心的使用与购买疑问解答。点击问题展开查看。
        </p>
      </div>

      <div class="faq-accordion-list">
        {FAQS.map(faq => (
          <details class="faq-item" open>
            <summary class="faq-title">
              <span class="category-tag">{faq.category}</span>
              <span class="question-text">{faq.question}</span>
              <svg class="chevron-icon" viewBox="0 0 16 16" fill="none">
                <path d="M4 6L8 10L12 6" stroke="#43C6D5" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="faq-content">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="faq-footer-cta text-center">
        <h3>仍有疑问或准备开通服务？</h3>
        <p>直接前往 FlyingBird 官方指定商业平台，查看最新的结算政策。</p>
        <a href={COMMERCIAL_AFF_URL} target="_blank" rel="sponsored nofollow noopener" class="btn btn-primary">
          前往官方平台下单 →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .faq-page {
    padding: 5rem 0;
  }

  .text-center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 900px;
    margin: 3rem auto;
  }

  .faq-item {
    background: rgba(12, 38, 61, 0.7);
    border: 1px solid rgba(67, 198, 213, 0.2);
    border-radius: 14px;
    overflow: hidden;
  }

  .faq-title {
    padding: 1.4rem 1.8rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: #F7FCFC;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 1rem;
    list-style: none;
  }

  .faq-title::-webkit-details-marker {
    display: none;
  }

  .category-tag {
    font-size: 0.75rem;
    background: rgba(67, 198, 213, 0.15);
    color: #43C6D5;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .question-text {
    flex: 1;
  }

  .chevron-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }

  details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .faq-content {
    padding: 0 1.8rem 1.6rem;
    font-size: 0.95rem;
    color: rgba(197, 233, 230, 0.85);
    line-height: 1.7;
    border-top: 1px dashed rgba(197, 233, 230, 0.1);
    margin-top: 0.5rem;
    padding-top: 1rem;
  }

  .faq-footer-cta {
    background: rgba(8, 30, 49, 0.6);
    border: 1px solid rgba(67, 198, 213, 0.15);
    border-radius: 20px;
    padding: 3rem 2rem;
    margin-top: 4rem;
  }

  .faq-footer-cta h3 {
    font-size: 1.5rem;
    margin-bottom: 0.6rem;
  }

  .faq-footer-cta p {
    font-size: 0.95rem;
    color: rgba(197, 233, 230, 0.75);
    margin-bottom: 1.5rem;
  }
</style>
