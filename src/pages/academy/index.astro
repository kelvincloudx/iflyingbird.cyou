---
// src/pages/academy/index.astro
import Layout from '../../layouts/Layout.astro';
import { ARTICLES } from '../../data/articles';

const title = "FlyingBird知识库与教程目录｜原创网络使用与技术指南";
const description = "阅读 FlyingBird 官方 7 篇原创技术文章，覆盖应用流量消耗排查、网络环境切换、一次性流量包管理、请求超时原因与日常自检流程。";
---

<Layout title={title} description={description} canonicalPath="/academy/">
  <section class="academy-directory-page">
    <div class="container">
      <div class="section-header text-center">
        <span class="tag-badge">教程与指南</span>
        <h1 class="section-title">FlyingBird 技术文章目录</h1>
        <p class="section-desc">
          汇集 7 篇精心撰写的原创网络指南，助您深入理解订阅服务、网络原理与故障排查。
        </p>
      </div>

      <div class="articles-grid">
        {ARTICLES.map((article, index) => (
          <article class="article-card">
            <div class="card-num">{String(index + 1).padStart(2, '0')}</div>
            <div class="card-meta">
              <span class="pub-date">{article.publishDate}</span>
              <span class="read-time">{article.readTime}</span>
            </div>
            <h2>
              <a href={article.url}>{article.title}</a>
            </h2>
            <p class="summary">{article.summary}</p>
            <div class="card-action">
              <a href={article.url} class="btn btn-secondary btn-sm">
                阅读全文 →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .academy-directory-page {
    padding: 5rem 0;
  }

  .text-center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .article-card {
    background: rgba(12, 38, 61, 0.7);
    border: 1px solid rgba(67, 198, 213, 0.18);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s, border-color 0.25s;
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: #43C6D5;
  }

  .card-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: #43C6D5;
    opacity: 0.6;
    margin-bottom: 0.5rem;
    font-family: monospace;
  }

  .card-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.82rem;
    color: rgba(197, 233, 230, 0.6);
    margin-bottom: 0.6rem;
  }

  .article-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.8rem;
    line-height: 1.4;
  }

  .article-card h2 a {
    color: #F7FCFC;
    text-decoration: none;
  }

  .article-card h2 a:hover {
    color: #43C6D5;
  }

  .summary {
    font-size: 0.92rem;
    color: rgba(197, 233, 230, 0.78);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
