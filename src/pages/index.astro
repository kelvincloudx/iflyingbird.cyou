---
// index.astro
import Layout from '../layouts/Layout.astro';
import { PLANS, COMMERCIAL_AFF_URL } from '../data/plans';
import { FAQS } from '../data/faq';
import { ARTICLES } from '../data/articles';

const title = "FlyingBird飞鸟机场｜套餐价格、流量管理与客户端指南";
const description = "了解FlyingBird的300GB月度套餐、300GB和1000GB一次性流量包，阅读网络切换、流量管理、客户端更新及连接排查教程。";

const monthlyPlan = PLANS.find(p => p.trafficType === 'monthly');
const onetimePlans = PLANS.filter(p => p.trafficType === 'onetime');

// Structured Data for Home Page
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://iflyingbird.cyou/#website",
      "url": "https://iflyingbird.cyou/",
      "name": "FlyingBird机场",
      "description": description,
      "inLanguage": "zh-CN"
    },
    {
      "@type": "FAQPage",
      "@id": "https://iflyingbird.cyou/#faq",
      "mainEntity": FAQS.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={title} 
  description={description} 
  canonicalPath="/" 
  structuredData={structuredData}
>
  <!-- Module 1: Immersive Cloud Sea Hero -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="tag-badge">FLYINGBIRD AETHER</span>
        <h1 class="hero-title">
          FlyingBird<br />
          <span class="hero-sub-glow">向更广阔的数字天空出发</span>
        </h1>
        <p class="hero-subtitle">
          了解 FlyingBird 的网络订阅套餐、流量规划和连接使用方式，在清晰的指导下完成日常网络配置。
        </p>
        <div class="hero-actions">
          <a href="/plans/" class="btn btn-primary">
            查看套餐 →
          </a>
          <a href="/journey/" class="btn btn-secondary">
            探索使用指南
          </a>
          <a 
            href={COMMERCIAL_AFF_URL} 
            target="_blank" 
            rel="sponsored nofollow noopener" 
            class="btn btn-orange"
          >
            立即注册
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Module 2: Brand Horizontal Narrative -->
  <section class="narrative-section">
    <div class="container">
      <div class="section-header">
        <span class="tag-badge">品牌核心概念</span>
        <h2 class="section-title">清晰、可靠的 FlyingBird 服务体系</h2>
        <p class="section-desc">打破复杂的技术门槛，让每一个出海需求都能获得透明的方案支撑。</p>
      </div>

      <div class="narrative-grid">
        <div class="narrative-card">
          <div class="card-icon">01</div>
          <h3>网络订阅基础</h3>
          <p>FlyingBird 专为全球加速与跨境连接设计，提供覆盖香港、日本、美国、德国等多个热点地区的高速中转节点，结合 BGP 优化线路，保障网页与数据请求的高效传输。</p>
        </div>

        <div class="narrative-card">
          <div class="card-icon">02</div>
          <h3>流量使用规划</h3>
          <p>拥有灵活的额度政策：按月重置的 300GB 月度套餐，以及按需购买、不过期的 300GB 与 1000GB 一次性流量包，清晰透明，无隐性消费。</p>
        </div>

        <div class="narrative-card">
          <div class="card-icon">03</div>
          <h3>多设备连接</h3>
          <p>全面兼容 Windows、macOS、iOS、Android 及 Linux 平台，支持 Clash、Shadowrocket、Stash 等主流代理客户端，配置导入一步到位。</p>
        </div>

        <div class="narrative-card">
          <div class="card-icon">04</div>
          <h3>常见问题排查</h3>
          <p>提供完善的技术知识库与自检闭环，从网络切换、DNS 解析到客户端升级备份，全方位辅助您独立解决连接疑难。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Module 3: Plan Workbench -->
  <section class="workbench-section" id="plans-workbench">
    <div class="container">
      <div class="section-header">
        <span class="tag-badge">套餐工作台</span>
        <h2 class="section-title">FlyingBird 完整订阅方案</h2>
        <p class="section-desc">左右对比订阅模式，选择最适合您日常节奏的流量分配方案。</p>
      </div>

      <div class="workbench-grid">
        <!-- Left Side: Monthly Plan -->
        <div class="workbench-column column-left">
          <div class="column-header">
            <span class="col-badge">月度订阅组</span>
            <h3>按月重置 · 稳定流转</h3>
            <p>适合高频日常查阅资料、视频播放与固定办公需求。</p>
          </div>

          {monthlyPlan && (
            <div class="plan-card monthly-featured">
              <div class="plan-header">
                <h4>{monthlyPlan.name}</h4>
                <div class="plan-price">
                  <span class="currency">¥</span>
                  <span class="amount">15</span>
                  <span class="unit">/ 月</span>
                </div>
              </div>

              <div class="plan-traffic-highlight">
                <span class="traffic-value">300GB</span>
                <span class="traffic-label">每月自动重置额度</span>
              </div>

              <ul class="feature-list">
                {monthlyPlan.features.map(f => (
                  <li>
                    <svg class="check-icon" viewBox="0 0 16 16" fill="none">
                      <path d="M4 8L7 11L12 4" stroke="#43C6D5" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>

              <div class="plan-action">
                <a 
                  href={COMMERCIAL_AFF_URL} 
                  target="_blank" 
                  rel="sponsored nofollow noopener" 
                  class="btn btn-primary full-btn"
                >
                  开通月付套餐
                </a>
              </div>
            </div>
          )}
        </div>

        <!-- Right Side: One-time Traffic Packages -->
        <div class="workbench-column column-right">
          <div class="column-header">
            <span class="col-badge orange">一次性流量组</span>
            <h3>不过期额度 · 买断备用</h3>
            <p>流量不过期，用完为止，适合低频或跨多设备长期备用。</p>
          </div>

          <div class="onetime-cards-stack">
            {onetimePlans.map(plan => (
              <div class="plan-card onetime-card">
                <div class="plan-header">
                  <div class="header-left">
                    <h4>{plan.name}</h4>
                    <span class="traffic-tag">{plan.traffic}</span>
                  </div>
                  <div class="plan-price">
                    <span class="currency">¥</span>
                    <span class="amount">{plan.priceNum}</span>
                    <span class="unit">/ 次</span>
                  </div>
                </div>

                <p class="plan-desc">{plan.description}</p>

                <div class="plan-action">
                  <a 
                    href={COMMERCIAL_AFF_URL} 
                    target="_blank" 
                    rel="sponsored nofollow noopener" 
                    class="btn btn-secondary full-btn"
                  >
                    购买 {plan.name}
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Module 4: Connection Journey -->
  <section class="journey-section">
    <div class="container">
      <div class="section-header">
        <span class="tag-badge">配置流程</span>
        <h2 class="section-title">FlyingBird 五步连接旅程</h2>
        <p class="section-desc">从零开始建立高品质网络连接的完整路径。</p>
      </div>

      <div class="timeline-container">
        <div class="timeline-step">
          <div class="step-number">01</div>
          <div class="step-content">
            <h3>了解方案</h3>
            <p>明确您的使用频率与设备数量，对比 300GB 月度套餐与一次性流量包的特性。</p>
          </div>
        </div>

        <div class="timeline-step">
          <div class="step-number">02</div>
          <div class="step-content">
            <h3>确认购买内容</h3>
            <p>前往 FlyingBird 官方指定商业平台，在下单界面仔细核对价格与结算方式。</p>
          </div>
        </div>

        <div class="timeline-step">
          <div class="step-number">03</div>
          <div class="step-content">
            <h3>获取实际订阅配置</h3>
            <p>在个人中心一键复制专属的 API 订阅链接，或使用一键导入按钮。</p>
          </div>
        </div>

        <div class="timeline-step">
          <div class="step-number">04</div>
          <div class="step-content">
            <h3>安装客户端</h3>
            <p>根据您的设备操作系统（Windows/macOS/iOS/Android），下载对应合规客户端。</p>
          </div>
        </div>

        <div class="timeline-step">
          <div class="step-number">05</div>
          <div class="step-content">
            <h3>连接测试</h3>
            <p>启动系统代理，执行节点 Ping 值检测与网页打开验证，享受流畅网络。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Module 5: Technical Knowledge -->
  <section class="tech-section">
    <div class="container">
      <div class="section-header">
        <span class="tag-badge">技术架构</span>
        <h2 class="section-title">底层技术保障与线路优化</h2>
        <p class="section-desc">FlyingBird 在网络节点架构上的四大硬核支撑。</p>
      </div>

      <div class="tech-grid">
        <div class="tech-card">
          <h3>BGP 多线中转架构</h3>
          <p>全节点部署优质 BGP 网络，智能自动调度最优数据通道，大幅降低跨国传输中的丢包率与网络延迟。</p>
        </div>

        <div class="tech-card">
          <h3>1000Mbps 端口峰值</h3>
          <p>全线节点配备 G 级大带宽端口，确保在多线程下载与高清视频流加载时拥有充沛的吞吐容量。</p>
        </div>

        <div class="tech-card">
          <h3>现代加密协议支持</h3>
          <p>全面兼容 Shadowsocks、Trojan、Vless 等现代化高强度传输协议，保障通信数据的私密与安全。</p>
        </div>

        <div class="tech-card">
          <h3>多地区边缘节点</h3>
          <p>节点覆盖香港、日本、新加坡、美国、德国等主要数字枢纽，满足不同区域流媒体与业务访问需求。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Module 6: 7 Original Articles -->
  <section class="academy-section">
    <div class="container">
      <div class="section-header">
        <span class="tag-badge">知识库指南</span>
        <h2 class="section-title">FlyingBird 原创技术文章</h2>
        <p class="section-desc">深入浅出的网络使用教程，助您掌握流量管理与故障排查。</p>
      </div>

      <div class="articles-numbered-list">
        {ARTICLES.map((article, index) => (
          <div class="article-item-card">
            <div class="item-index">{String(index + 1).padStart(2, '0')}</div>
            <div class="item-body">
              <div class="item-meta">
                <span class="item-date">{article.publishDate}</span>
                <span class="item-read">{article.readTime}</span>
              </div>
              <h3 class="item-title">
                <a href={article.url}>{article.title}</a>
              </h3>
              <p class="item-summary">{article.summary}</p>
            </div>
            <div class="item-action">
              <a href={article.url} class="read-link">
                阅读全文 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Module 7: Usage Experience & Points of Attention (Independent Light Cloud White Area) -->
  <section class="experience-section">
    <div class="container">
      <div class="exp-header">
        <span class="exp-badge">体验视角</span>
        <h2 class="exp-title">FlyingBird 使用体验关注点</h2>
        <p class="exp-subtitle">不同的使用环境，对流量、连接与设备管理有着不同的要求。</p>
      </div>

      <div class="exp-grid">
        <div class="exp-card">
          <div class="exp-card-header">
            <span class="exp-num">01</span>
            <h3>日常学习与查阅</h3>
          </div>
          <p class="exp-text">
            重点关注网页打开速度、技术文档浏览流畅度、月度流量额度的分配，以及访问海外学术资源时的连接稳定性。
          </p>
        </div>

        <div class="exp-card">
          <div class="exp-card-header">
            <span class="exp-num">02</span>
            <h3>跨设备使用</h3>
          </div>
          <p class="exp-text">
            重点关注笔记本电脑与智能手机之间的无缝接续、Wi-Fi 切换到移动热点后的代理刷新，以及多终端订阅同步规范。
          </p>
        </div>

        <div class="exp-card">
          <div class="exp-card-header">
            <span class="exp-num">03</span>
            <h3>大流量任务</h3>
          </div>
          <p class="exp-text">
            重点关注大文件下载、系统更新包获取、云端数据自动同步对总流量的快速消耗，合理选择一次性流量包额度。
          </p>
        </div>

        <div class="exp-card">
          <div class="exp-card-header">
            <span class="exp-num">04</span>
            <h3>长期连接维护</h3>
          </div>
          <p class="exp-text">
            重点关注客户端软件更新前的配置备份、代理规则分流设置、节点 Ping 值评估误判排查，建立标准自检习惯。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Module 8: FAQ (Default All Expanded) -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header">
        <span class="tag-badge">常见解答</span>
        <h2 class="section-title">FlyingBird 常见问题 FAQ</h2>
        <p class="section-desc">关于套餐、流量、网络排查与订阅购买的完整解答。</p>
      </div>

      <div class="faq-list-expanded">
        {FAQS.map(faq => (
          <div class="faq-card-open">
            <h3 class="faq-question">
              <svg class="q-icon" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="9" stroke="#43C6D5" stroke-width="1.5"/>
                <path d="M7 8C7 6.5 8.2 5.5 10 5.5C11.8 5.5 13 6.5 13 8C13 9.5 11.5 10.2 10.5 11V12.5" stroke="#43C6D5" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="10" cy="15" r="1" fill="#43C6D5"/>
              </svg>
              <span>{faq.question}</span>
            </h3>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Module 1: Hero */
  .hero-section {
    padding: 6rem 0 5rem;
    position: relative;
    text-align: center;
  }

  .hero-container {
    display: flex;
    justify-content: center;
  }

  .hero-content {
    max-width: 820px;
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.15;
    margin: 1.2rem 0;
    font-weight: 800;
  }

  .hero-sub-glow {
    background: linear-gradient(135deg, #43C6D5 0%, #C5E9E6 50%, #F4A261 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: rgba(197, 233, 230, 0.85);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Module 2: Narrative */
  .narrative-section {
    padding: 4rem 0;
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .narrative-card {
    background: rgba(12, 38, 61, 0.6);
    border: 1px solid rgba(67, 198, 213, 0.15);
    border-radius: 14px;
    padding: 1.8rem 1.4rem;
    backdrop-filter: blur(8px);
    transition: transform 0.3s, border-color 0.3s;
  }

  .narrative-card:hover {
    transform: translateY(-4px);
    border-color: rgba(67, 198, 213, 0.4);
  }

  .card-icon {
    font-size: 1.8rem;
    font-weight: 800;
    color: #43C6D5;
    opacity: 0.8;
    margin-bottom: 0.8rem;
  }

  .narrative-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }

  .narrative-card p {
    font-size: 0.92rem;
    color: rgba(197, 233, 230, 0.75);
    line-height: 1.6;
  }

  /* Module 3: Workbench */
  .workbench-section {
    padding: 5rem 0;
  }

  .workbench-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .workbench-column {
    background: rgba(8, 30, 49, 0.5);
    border: 1px solid rgba(67, 198, 213, 0.2);
    border-radius: 20px;
    padding: 2rem;
  }

  .column-header {
    margin-bottom: 1.8rem;
  }

  .col-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(67, 198, 213, 0.15);
    color: #43C6D5;
    margin-bottom: 0.5rem;
  }

  .col-badge.orange {
    background: rgba(244, 162, 97, 0.15);
    color: #F4A261;
  }

  .column-header h3 {
    font-size: 1.4rem;
    margin-bottom: 0.3rem;
  }

  .column-header p {
    font-size: 0.9rem;
    color: rgba(197, 233, 230, 0.7);
  }

  .plan-card {
    background: rgba(12, 38, 61, 0.85);
    border: 1px solid rgba(67, 198, 213, 0.25);
    border-radius: 14px;
    padding: 1.8rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .plan-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.2rem;
  }

  .plan-header h4 {
    font-size: 1.3rem;
  }

  .plan-price {
    text-align: right;
  }

  .plan-price .currency {
    font-size: 1.1rem;
    color: #43C6D5;
    font-weight: 600;
  }

  .plan-price .amount {
    font-size: 2.2rem;
    font-weight: 800;
    color: #F7FCFC;
  }

  .plan-price .unit {
    font-size: 0.85rem;
    color: rgba(197, 233, 230, 0.7);
  }

  .plan-traffic-highlight {
    background: rgba(67, 198, 213, 0.1);
    border: 1px stroke rgba(67, 198, 213, 0.2);
    border-radius: 8px;
    padding: 0.8rem 1rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .traffic-value {
    font-size: 1.3rem;
    font-weight: 800;
    color: #43C6D5;
  }

  .traffic-label {
    font-size: 0.85rem;
    color: #C5E9E6;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: rgba(197, 233, 230, 0.9);
  }

  .check-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .full-btn {
    width: 100%;
  }

  .onetime-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .onetime-card {
    padding: 1.4rem 1.6rem;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .traffic-tag {
    display: inline-block;
    font-size: 0.8rem;
    color: #F4A261;
    font-weight: 600;
  }

  .plan-desc {
    font-size: 0.9rem;
    color: rgba(197, 233, 230, 0.75);
    margin-bottom: 1.2rem;
    line-height: 1.5;
  }

  /* Module 4: Timeline */
  .journey-section {
    padding: 4rem 0;
  }

  .timeline-container {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.2rem;
    position: relative;
  }

  .timeline-step {
    background: rgba(12, 38, 61, 0.6);
    border: 1px solid rgba(67, 198, 213, 0.15);
    border-radius: 12px;
    padding: 1.5rem 1.2rem;
    position: relative;
  }

