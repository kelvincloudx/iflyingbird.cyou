---
// Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CloudMotionBackground from '../components/CloudMotionBackground.astro';
import WindCursor from '../components/WindCursor.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  structuredData?: object;
}

const {
  title,
  description,
  canonicalPath = '',
  ogType = 'website',
  structuredData
} = Astro.props;

const siteDomain = 'https://iflyingbird.cyou';
const cleanPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = `${siteDomain}${cleanPath === '/' ? '' : cleanPath}`;
const pageTitle = title.includes('FlyingBird') ? title : `${title} | FlyingBird机场`;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO Core -->
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:site_name" content="FlyingBird机场" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={`${siteDomain}/favicon.svg`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />

  <!-- Structured Data JSON-LD -->
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body>
  <!-- Dynamic Cloud & Sunbeam Background -->
  <CloudMotionBackground />

  <!-- Custom Wind Trail Mouse Cursor -->
  <WindCursor />

  <!-- Header -->
  <Header currentPath={cleanPath} />

  <!-- Main Content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <Footer />
</body>
</html>
