---
// CloudMotionBackground.astro
---

<div id="cloud-motion-container" aria-hidden="true">
  <!-- Soft Sunrise Glow / Dawn Light Beam -->
  <div class="dawn-beam"></div>

  <!-- Layered Animated Clouds -->
  <div class="cloud-layer layer-back">
    <svg class="cloud-svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill="rgba(197, 233, 230, 0.15)" d="M0,192L48,181.3C96,171,192,149,288,154.7C384,160,480,192,576,197.3C672,203,768,181,864,154.7C960,128,1056,96,1152,106.7C1248,117,1344,171,1392,197.3L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>
  </div>

  <div class="cloud-layer layer-mid">
    <svg class="cloud-svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill="rgba(67, 198, 213, 0.08)" d="M0,96L60,112C120,128,240,160,360,170.7C480,181,600,171,720,149.3C840,128,960,96,1080,96C1200,96,1320,128,1380,144L1440,160L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"></path>
    </svg>
  </div>

  <div class="cloud-layer layer-front">
    <svg class="cloud-svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill="rgba(247, 252, 252, 0.05)" d="M0,224L80,202.7C160,181,320,139,480,144C640,149,800,203,960,208C1120,213,1280,171,1360,149.3L1440,128L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"></path>
    </svg>
  </div>

  <!-- Canvas for Flying Birds and Particles -->
  <canvas id="cloud-motion-canvas"></canvas>
</div>

<style>
  #cloud-motion-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(circle at 50% 20%, #0c2840 0%, #081e31 70%, #051321 100%);
  }

  .dawn-beam {
    position: absolute;
    top: -20vh;
    left: 50%;
    transform: translateX(-50%);
    width: 80vw;
    height: 80vh;
    background: radial-gradient(ellipse at center, rgba(244, 162, 97, 0.15) 0%, rgba(67, 198, 213, 0.08) 45%, transparent 70%);
    filter: blur(50px);
    animation: dawnPulse 12s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes dawnPulse {
    0% { opacity: 0.6; transform: translateX(-50%) scale(0.95); }
    100% { opacity: 1; transform: translateX(-48%) scale(1.08); }
  }

  .cloud-layer {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 200%;
    height: 45vh;
    pointer-events: none;
  }

  .cloud-svg {
    width: 100%;
    height: 100%;
  }

  .layer-back {
    animation: cloudDriftBack 45s linear infinite;
  }

  .layer-mid {
    animation: cloudDriftMid 30s linear infinite;
    bottom: -5vh;
  }

  .layer-front {
    animation: cloudDriftFront 22s linear infinite;
    bottom: -10vh;
  }

  @keyframes cloudDriftBack {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes cloudDriftMid {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  @keyframes cloudDriftFront {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  #cloud-motion-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dawn-beam, .layer-back, .layer-mid, .layer-front {
      animation: none !important;
    }
  }

  @media (max-width: 768px) {
    .layer-back { display: none; }
  }
</style>

<script>
  // Lightweight Canvas 2D flight silhouettes script
  function initCloudCanvas() {
    const canvas = document.getElementById('cloud-motion-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animId: number;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth <= 768;

    function resize() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    // SVG bird path data simulated in Canvas 2D
    interface Bird {
      x: number;
      y: number;
      speed: number;
      size: number;
      wingAngle: number;
      wingSpeed: number;
      opacity: number;
      amplitude: number;
      initialY: number;
    }

    const birdCount = isMobile ? 3 : 7;
    const birds: Bird[] = [];

    for (let i = 0; i < birdCount; i++) {
      birds.push({
        x: Math.random() * width,
        y: Math.random() * (height * 0.5) + height * 0.1,
        speed: 0.4 + Math.random() * 0.6,
        size: 12 + Math.random() * 10,
        wingAngle: Math.random() * Math.PI * 2,
        wingSpeed: 0.05 + Math.random() * 0.05,
        opacity: 0.3 + Math.random() * 0.4,
        amplitude: 15 + Math.random() * 25,
        initialY: Math.random() * (height * 0.4) + height * 0.1
      });
    }

    let scrollY = window.scrollY;
    window.addEventListener('scroll', () => {
      scrollY = window.scrollY;
    }, { passive: true });

    function drawBird(b: Bird) {
      if (!ctx) return;
      ctx.save();
      ctx.translate(b.x, b.y + scrollY * 0.05); // subtle parallax
      ctx.globalAlpha = b.opacity;
      ctx.strokeStyle = '#43C6D5';
      ctx.lineWidth = 1.8;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      const s = b.size;
      const wingY = Math.sin(b.wingAngle) * (s * 0.5);

      // Bird wing silhouette
      ctx.beginPath();
      ctx.moveTo(-s, wingY);
      ctx.quadraticCurveTo(-s * 0.4, -s * 0.3, 0, 0);
      ctx.quadraticCurveTo(s * 0.4, -s * 0.3, s, wingY);
      ctx.stroke();

      ctx.restore();
    }

    function animate() {
      if (document.hidden || prefersReducedMotion) {
        animId = requestAnimationFrame(animate);
        return;
      }

      ctx?.clearRect(0, 0, width, height);

      for (let i = 0; i < birds.length; i++) {
        const b = birds[i];
        b.x += b.speed;
        b.wingAngle += b.wingSpeed;
        b.y = b.initialY + Math.sin(b.x * 0.005) * b.amplitude;

        if (b.x > width + 40) {
          b.x = -40;
          b.initialY = Math.random() * (height * 0.4) + height * 0.1;
        }

        drawBird(b);
      }

      animId = requestAnimationFrame(animate);
    }

    animate();
  }

  // Run on page load
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initCloudCanvas();
  } else {
    document.addEventListener('DOMContentLoaded', initCloudCanvas);
  }
</script>
